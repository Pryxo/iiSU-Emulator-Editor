{
  "description": "DroidDeck by ???, https://github.com/Droid-Deck/DroidDeck",
  "status": 1, 
  "entries": [
    {
      "shortName": "steam",
      "emulator": {
        "id": "droiddeck",
        "name": "DroidDeck (Standalone)",
        "routeType": "fileContent",
        "commands": [
          {
            "description": "DroidDeck",
            "command": "%PACKAGE%/.MainActivity -a com.droiddeck.launcher.LAUNCH_GAME -e app_id %ROM_CONTENT%"
          },
          {
            "description": "DroidDeck (Game URI)",
            "command": "%PACKAGE%/.MainActivity -a android.intent.action.VIEW -d droiddeck://game/%ROM_CONTENT%"
          },
          {
            "description": "DroidDeck (Game URI - Frontend)",
            "command": "%PACKAGE%/.FrontEndActivity -a android.intent.action.VIEW -d droiddeck://game/%ROM_CONTENT%"
          },
          {
            "description": "DroidDeck (Legacy)",
            "command": "%PACKAGE%/.MainActivity -a app.gamenative.LAUNCH_GAME -e app_id %ROM_CONTENT%"
          }
        ],
        "packages": [
          "com.droiddeck.launcher"
        ]
      }
    }
  ]
}